# Modelo para Advanced settings → Secrets do Streamlit Community Cloud.
# Substitua os valores fora do repositório. Não envie o arquivo preenchido ao GitHub.
LABEER_ENV = "cloud_pilot"
# Altere para "true" somente para o app configurado como privado e com dados fictícios.
LABEER_CLOUD_PRIVATE_ACK = "false"
LABEER_DATABASE_URL = "postgresql+psycopg://usuario:senha@postgres.example.test:5432/labeer_piloto?sslmode=verify-full&sslrootcert=system"
LABEER_ADMIN_EMAIL = "admin@example.test"
LABEER_ADMIN_PASSWORD = ""
LABEER_SMTP_ENABLED = "false"
