LABEER_ENV=development
LABEER_DATABASE_URL=sqlite:///labeer_dev.db
# Necessários apenas no primeiro acesso a um banco que ainda não tenha administrador.
LABEER_ADMIN_EMAIL=admin@labeer.local
LABEER_ADMIN_PASSWORD=

# Envio desativado por padrão. Configure somente com um servidor SMTP autorizado.
LABEER_SMTP_ENABLED=false
LABEER_SMTP_SECURITY=starttls
LABEER_SMTP_PORT=587
LABEER_SMTP_HOST=
LABEER_SMTP_FROM=
LABEER_SMTP_USER=
LABEER_SMTP_PASSWORD=

# Para o piloto online, use o modelo separado em .streamlit/secrets.toml.example.

